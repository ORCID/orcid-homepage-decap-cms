{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orcid.github.io/orcid-homepage-decap-cms/schema/home.schema.json",
  "$comment": "GENERATED FILE — do not edit. Produced by scripts/gen/schema.mjs from schema/catalogue.json; run `npm run gen` after editing the catalogue.",
  "title": "ORCID homepage content",
  "description": "The contract between this repository and the Angular renderer in orcid-angular. schemaVersion changes only for a breaking change; a new section type, variant or optional field bumps catalogueVersion alone, and an older renderer drops a section whose type it does not know.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogueVersion", "page", "sections"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "catalogueVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "The catalogue this document was authored against. Not pinned to one value: additive catalogue changes are not breaking, so a renderer accepts any of them."
    },
    "page": {
      "$ref": "#/$defs/page"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["type"],
        "discriminator": {
          "propertyName": "type"
        },
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id", "variant", "layout", "audiences"],
            "properties": {
              "type": {
                "const": "audience-selector"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "variant": {
                "enum": ["tabs-photo", "tabs-flat", "stacked"],
                "description": "The variants of this section type only. A renderer that does not know the value falls back to the first one listed (D4)."
              },
              "layout": {
                "$ref": "#/$defs/layout"
              },
              "title": {
                "$ref": "#/$defs/plainText",
                "maxLength": 192
              },
              "audiences": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label", "intro", "features"],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "label": {
                      "$ref": "#/$defs/plainText",
                      "maxLength": 96
                    },
                    "intro": {
                      "$ref": "#/$defs/richText",
                      "maxLength": 1280
                    },
                    "background": {
                      "$ref": "#/$defs/decorativeImage"
                    },
                    "features": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "body"],
                        "properties": {
                          "id": {
                            "$ref": "#/$defs/id"
                          },
                          "title": {
                            "$ref": "#/$defs/plainText",
                            "maxLength": 128
                          },
                          "body": {
                            "$ref": "#/$defs/richText",
                            "maxLength": 800
                          },
                          "icon": {
                            "$ref": "#/$defs/decorativeImage"
                          },
                          "link": {
                            "$ref": "#/$defs/link"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id", "variant", "layout", "mediaKind"],
            "properties": {
              "type": {
                "const": "media"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "variant": {
                "enum": ["media-end", "media-below", "media-only"],
                "description": "The variants of this section type only. A renderer that does not know the value falls back to the first one listed (D4)."
              },
              "layout": {
                "$ref": "#/$defs/layout"
              },
              "kicker": {
                "$ref": "#/$defs/plainText",
                "maxLength": 64
              },
              "title": {
                "$ref": "#/$defs/plainText",
                "maxLength": 320
              },
              "body": {
                "$ref": "#/$defs/richText",
                "maxLength": 1920
              },
              "mediaKind": {
                "enum": ["video", "image"],
                "default": "video"
              },
              "video": {
                "$ref": "#/$defs/video"
              },
              "image": {
                "$ref": "#/$defs/informativeImage"
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "$ref": "#/$defs/action"
                }
              }
            },
            "allOf": [
              {
                "$comment": "\"video\" is required only when \"mediaKind\" is \"video\".",
                "if": {
                  "properties": {
                    "mediaKind": {
                      "const": "video"
                    }
                  },
                  "required": ["mediaKind"]
                },
                "then": {
                  "required": ["video"]
                }
              },
              {
                "$comment": "\"image\" is required only when \"mediaKind\" is \"image\".",
                "if": {
                  "properties": {
                    "mediaKind": {
                      "const": "image"
                    }
                  },
                  "required": ["mediaKind"]
                },
                "then": {
                  "required": ["image"]
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id", "variant", "layout", "items"],
            "properties": {
              "type": {
                "const": "feature-list"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "variant": {
                "enum": ["cards", "columns", "panel", "checklist"],
                "description": "The variants of this section type only. A renderer that does not know the value falls back to the first one listed (D4)."
              },
              "layout": {
                "$ref": "#/$defs/layout"
              },
              "title": {
                "$ref": "#/$defs/plainText",
                "maxLength": 320
              },
              "intro": {
                "$ref": "#/$defs/richText",
                "maxLength": 960
              },
              "columns": {
                "enum": [2, 3],
                "default": 3
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 9,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "body"],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "title": {
                      "$ref": "#/$defs/plainText",
                      "maxLength": 128
                    },
                    "body": {
                      "$ref": "#/$defs/richText",
                      "maxLength": 800
                    },
                    "icon": {
                      "$ref": "#/$defs/decorativeImage"
                    },
                    "link": {
                      "$ref": "#/$defs/link"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id", "variant", "layout", "title", "links"],
            "properties": {
              "type": {
                "const": "quick-links"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "variant": {
                "enum": ["bar", "grid", "list"],
                "description": "The variants of this section type only. A renderer that does not know the value falls back to the first one listed (D4)."
              },
              "layout": {
                "$ref": "#/$defs/layout"
              },
              "title": {
                "$ref": "#/$defs/plainText",
                "maxLength": 192
              },
              "titleHidden": {
                "type": "boolean",
                "default": true
              },
              "links": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label", "href"],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "label": {
                      "$ref": "#/$defs/plainText",
                      "maxLength": 96
                    },
                    "href": {
                      "$ref": "#/$defs/href"
                    },
                    "description": {
                      "$ref": "#/$defs/plainText",
                      "maxLength": 192
                    },
                    "icon": {
                      "$ref": "#/$defs/decorativeImage"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id", "variant", "layout", "body"],
            "properties": {
              "type": {
                "const": "prose"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "variant": {
                "enum": ["default", "lead", "centered"],
                "description": "The variants of this section type only. A renderer that does not know the value falls back to the first one listed (D4)."
              },
              "layout": {
                "$ref": "#/$defs/layout"
              },
              "title": {
                "$ref": "#/$defs/plainText",
                "maxLength": 320
              },
              "body": {
                "$ref": "#/$defs/richText",
                "maxLength": 3200
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id", "variant", "layout", "title", "actions"],
            "properties": {
              "type": {
                "const": "cta-band"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "variant": {
                "enum": ["band", "panel", "inline"],
                "description": "The variants of this section type only. A renderer that does not know the value falls back to the first one listed (D4)."
              },
              "layout": {
                "$ref": "#/$defs/layout"
              },
              "title": {
                "$ref": "#/$defs/plainText",
                "maxLength": 320
              },
              "body": {
                "$ref": "#/$defs/richText",
                "maxLength": 960
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "$ref": "#/$defs/action"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id", "variant", "layout", "title", "source"],
            "properties": {
              "type": {
                "const": "news-feed"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "variant": {
                "enum": ["grid", "list"],
                "description": "The variants of this section type only. A renderer that does not know the value falls back to the first one listed (D4)."
              },
              "layout": {
                "$ref": "#/$defs/layout"
              },
              "title": {
                "$ref": "#/$defs/plainText",
                "maxLength": 192
              },
              "source": {
                "enum": ["orcid-blog"],
                "default": "orcid-blog"
              },
              "maxItems": {
                "type": "integer",
                "minimum": 2,
                "maximum": 6,
                "default": 3
              }
            }
          }
        ]
      }
    },
    "meta": {
      "$ref": "#/$defs/meta"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,59}$",
      "description": "Stable translation key. Renaming it orphans every translation of that item."
    },
    "plainText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]*$",
      "description": "One line of text. maxLength is set per field from the catalogue, with 1.6x headroom for translations."
    },
    "richText": {
      "type": "string",
      "minLength": 1,
      "description": "markdown-lite: paragraphs, **bold** and [text](https://…) links only. The grammar is enforced by scripts/lib/markdown-lint.mjs, not here."
    },
    "altText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]*$",
      "description": "Alt text. Quality rules (no \"image of\", not the filename, not empty on an informative image) are enforced by validate.mjs."
    },
    "href": {
      "type": "string",
      "pattern": "^(https://[^\\s]+|mailto:[^\\s@]+@[^\\s@]+)$",
      "description": "A full https:// address or mailto:someone@example.org. The host allowlist is enforced by validate.mjs."
    },
    "imagePath": {
      "type": "string",
      "pattern": "^(images|assets)/[A-Za-z0-9._-]+\\.(png|jpe?g|svg|webp)$",
      "description": "images/… in the source file, rewritten to the fingerprinted assets/… by the build."
    },
    "decorativeImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src"],
      "properties": {
        "src": {
          "$ref": "#/$defs/imagePath"
        },
        "focalPoint": {
          "enum": ["center", "top", "bottom", "start", "end"],
          "default": "center"
        }
      },
      "description": "A picture that carries no information: the renderer always emits alt=\"\" aria-hidden=\"true\", so there is no alt property to fill in or to forget."
    },
    "informativeImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt"],
      "properties": {
        "src": {
          "$ref": "#/$defs/imagePath"
        },
        "focalPoint": {
          "enum": ["center", "top", "bottom", "start", "end"],
          "default": "center"
        },
        "alt": {
          "$ref": "#/$defs/altText",
          "maxLength": 240
        },
        "containsText": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "A picture that carries information. alt is required here and nowhere else."
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "span": {
          "enum": ["full", "half"],
          "default": "full"
        },
        "spacing": {
          "enum": ["compact", "normal", "loose"],
          "default": "normal"
        },
        "tone": {
          "enum": ["default", "surface", "brand-dark", "brand-tint"],
          "default": "default"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": {
          "$ref": "#/$defs/plainText",
          "maxLength": 128
        },
        "href": {
          "$ref": "#/$defs/href"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "href"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/plainText",
          "maxLength": 96
        },
        "href": {
          "$ref": "#/$defs/href"
        },
        "style": {
          "enum": ["primary", "secondary"],
          "default": "primary"
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "videoId",
        "title",
        "poster",
        "captions",
        "audioDescription"
      ],
      "properties": {
        "provider": {
          "enum": ["vimeo", "youtube"]
        },
        "videoId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "$ref": "#/$defs/plainText",
          "maxLength": 192
        },
        "aspectRatio": {
          "enum": ["16:9", "4:3", "1:1", "9:16"],
          "default": "16:9"
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36000
        },
        "startAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36000
        },
        "poster": {
          "$ref": "#/$defs/informativeImage"
        },
        "captions": {
          "$ref": "#/$defs/captions"
        },
        "audioDescription": {
          "$ref": "#/$defs/audioDescription"
        },
        "transcript": {
          "$ref": "#/$defs/richText",
          "maxLength": 32000
        }
      },
      "allOf": [
        {
          "$comment": "A Vimeo id looks like 1198760040.",
          "if": {
            "properties": {
              "provider": {
                "const": "vimeo"
              }
            },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "videoId": {
                "pattern": "^[0-9]{1,20}$"
              }
            }
          }
        },
        {
          "$comment": "A YouTube id looks like 1rZvFGLe7bg.",
          "if": {
            "properties": {
              "provider": {
                "const": "youtube"
              }
            },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "videoId": {
                "pattern": "^[A-Za-z0-9_-]{11}$"
              }
            }
          }
        }
      ]
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "locales"],
      "properties": {
        "available": {
          "type": "boolean",
          "const": true,
          "default": true
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})?$"
          }
        },
        "autoGenerated": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "audioDescription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["described-track", "not-needed"]
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      },
      "allOf": [
        {
          "$comment": "\"justification\" is required only when \"status\" is \"not-needed\".",
          "if": {
            "properties": {
              "status": {
                "const": "not-needed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["justification"]
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": {
          "$ref": "#/$defs/plainText",
          "maxLength": 192
        },
        "description": {
          "$ref": "#/$defs/plainText",
          "maxLength": 320
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "version",
        "commit",
        "generatedAt",
        "translated",
        "total"
      ],
      "properties": {
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "translated": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "untranslated": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Keys that fell back to English (§8.7). Absent on a fully translated bundle."
        }
      },
      "description": "Written by scripts/build.mjs. Absent from the source file, present on every built bundle."
    }
  }
}
