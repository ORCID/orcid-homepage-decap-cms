{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orcid.github.io/orcid-homepage-decap-cms/schema/home.schema.json",
  "title": "ORCID homepage content",
  "description": "The contract between this repository and the Angular renderer in orcid-angular. Bump schemaVersion only for a breaking change; old Angular builds refuse an unknown major and fall back to their static homepage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hero",
    "audiences",
    "featuredNews",
    "integrate"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "meta": { "$ref": "#/$defs/meta" },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/plainText" }
      }
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "background", "intro", "features"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/plainText" },
          "background": { "$ref": "#/$defs/imagePath" },
          "intro": { "$ref": "#/$defs/richText" },
          "features": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "icon", "title", "body"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "icon": { "$ref": "#/$defs/imagePath" },
                "title": { "$ref": "#/$defs/plainText" },
                "body": { "$ref": "#/$defs/richText" }
              }
            }
          }
        }
      }
    },
    "featuredNews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kicker", "title", "body", "vimeoId"],
      "properties": {
        "kicker": { "$ref": "#/$defs/plainText" },
        "title": { "$ref": "#/$defs/plainText" },
        "body": { "$ref": "#/$defs/richText" },
        "vimeoId": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$",
          "description": "Digits only. The renderer builds the player URL itself; a non-numeric value would be rejected there too."
        }
      }
    },
    "integrate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "paragraphs"],
      "properties": {
        "title": { "$ref": "#/$defs/plainText" },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "body"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "body": { "$ref": "#/$defs/richText" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1,
      "maxLength": 60,
      "description": "Stable translation key for this item. Renaming it orphans every translation of that item."
    },
    "plainText": { "type": "string", "minLength": 1, "maxLength": 300 },
    "richText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Markdown-lite: paragraphs, **bold** and [text](https://…) links only. Enforced by scripts/lib/markdown-lint.mjs, not by this schema."
    },
    "imagePath": {
      "type": "string",
      "pattern": "^(images|assets)/[A-Za-z0-9._-]+\\.(png|jpe?g|svg|webp)$",
      "description": "images/… in the source file, rewritten to the fingerprinted assets/… by the build."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "version",
        "commit",
        "generatedAt",
        "translated",
        "total"
      ],
      "properties": {
        "locale": { "type": "string", "minLength": 2, "maxLength": 10 },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "translated": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
